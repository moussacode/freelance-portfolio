# Copie ce fichier en .env (jamais versionné) et remplis les valeurs.
# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secrète : jamais de préfixe NEXT_PUBLIC_. Sert uniquement au script scripts/seed.ts, en local.
SUPABASE_SECRET_KEY=
# Secret partagé avec le Cron Vercel (/api/keep-alive), 32 caractères minimum.
CRON_SECRET=
# Statistiques de la carte « Visites » (admin). Token Vercel, portée : l'équipe ; avec une date d'expiration.
# Côté serveur uniquement (server-only) ; absent ou expiré : « Statistiques indisponibles ».
VERCEL_ANALYTICS_TOKEN=
